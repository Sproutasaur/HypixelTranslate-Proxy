    "baseUrl": "https://api.deepseek.com",
    "apiKey": "",
    "model": "deepseek-flash",
    "timeoutMs": 2500,
    "maxQueue": 40,
    "cacheSize": 2000,
    "systemPrompt": "你是 Minecraft 聊天翻译器。把用户给出的聊天内容翻译成目标语言。要求：只输出译文本身，不要解释、不要加引号；玩家名、队伍标签、数字、坐标、命令(/开头)、物品ID、颜色代码不要翻译；Minecraft 黑话按玩家圈习惯处理（gg=打得漂亮，ez=轻松，wp=打得不错，creeper=苦力怕，nether=下界，ender=末影）；保留原来的语气，口语化，简短。"
  },
  "tab": {
    "enabled": true,
    "hypixelApiKey": "",
    "apiBase": "https://api.hypixel.net/v2",
    "dataSource": "auto",
    "thirdPartyBaseUrl": "https://api.khadow.lol",
    "stat": "bedwars_fkdr",
    "label": "FKDR",
    "separator": " §7| ",
    "valueColor": "§b",
    "cacheMinutes": 180,
    "maxRequestsPerMinute": 30,
    "concurrency": 8,
    "showPlaceholder": false,
    "showUnknown": false,
    "showRankPrefix": false
  }
