{
  "listenHost": "127.0.0.1",
  "listenPort": 25565,
  "motd": {
    "text": "§aHypixelTranslate-Proxy §7· §b本地翻译代理",
    "online": 1,
    "max": 1
  },
  "upstreamHost": "mc.hypixel.net",
  "upstreamPort": 25565,
  "handshakeHost": "mc.hypixel.net",
  "handshakePort": 25565,
  "protocolVersion": 47,
  "authFile": "auth.json",
  "openBrowserOnLogin": true,
  "copyCodeToClipboardOnLogin": true,
  "idleTimeoutSeconds": 60,
  "debugSkipAuth": false,
  "debugName": "ProxyBot",
  "debugSkipSessionJoin": false,
  "debugTab": false,
  "translate": {
    "enabled": true,
    "targetLanguage": "zh-CN",
    "appendWaitMs": 250,
    "translateOutgoing": true,
    "outgoingTargetLanguage": "en",
    "skipOwnMessages": true,
    "translateSystem": true,
    "onlyPlayerChat": true,
    "skipIfAlreadyTarget": true,
    "dedupSeconds": 60,
    "skipShortMessages": 10,
    "skipPrefixes": [
      "[NPC]"
    ],
    "skipWords": [
      "gg",
      "ggwp",
      "wp",
      "ez",
      "ezpz",
      "l",
