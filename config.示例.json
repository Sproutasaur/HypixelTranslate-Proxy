      "lmfao",
      "rofl",
      "xd",
      "omg",
      "kek",
      "kekw",
      "rip",
      "gl",
      "hf",
      "glhf",
      "gf",
      "hi",
      "hey",
      "yo",
      "sup",
      "ty",
      "thx",
      "tyt",
      "brb",
      "afk",
      "gtg",
      "ok",
      "okay",
      "nvm",
      "o7",
      "salute",
      "f",
      "ff",
      "w",
